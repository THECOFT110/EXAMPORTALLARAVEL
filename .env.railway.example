# Application
APP_NAME="SALU Exam Portal"
APP_ENV=production
APP_KEY=base64:1Nlg/kjz4Whi8ehGhom7Aa+v/OolCGWLppE5SZJO8Ro=
APP_DEBUG=false
APP_URL=https://${RAILWAY_PUBLIC_DOMAIN}

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Database (Supabase PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=db.rgizccerktxlvticwwmb.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=jawadJAAN@1990
DB_SCHEMA=public
DB_SSLMODE=require

# Run migrations automatically on deploy (set to true or false)
RUN_MIGRATIONS=false

# Logging & Sessions
LOG_CHANNEL=stderr
LOG_LEVEL=error
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue
CACHE_STORE=database
CACHE_PREFIX=salu_cache
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail (Resend or SMTP)
MAIL_MAILER=log
RESEND_API_KEY=re_test_dummy_key_123
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# SALU Exam Portal Settings
ENROLLMENT_FEE_AMOUNT=1500
EXAM_FEE_AMOUNT=2000
LATE_FEE_AMOUNT=500
CHALLAN_VALIDITY_DAYS=7
ITEMS_PER_PAGE=20
ADMIN_ITEMS_PER_PAGE=50
MAX_FILE_SIZE=5120
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png
